[Unit]
Description=wroclaw-sky OpenSky fetcher (for Render UI upstream)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/src/wroclaw-sky
Environment=PORT=8082
Environment=LOG_FORMAT=json
Environment=LOG_LEVEL=info
EnvironmentFile=-/etc/wroclaw-sky/fetcher.env
ExecStart=/usr/local/bin/wroclaw-sky
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
